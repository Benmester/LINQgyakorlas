const string FilePath = "..\\..\\..\\data\\arukeszlet.csv";
using StreamReader sr = new(FilePath);
_ = sr.ReadLine();
while (!sr.EndOfStream)
{
    var tmp = sr.ReadLine().Split(',');
    products.Add(new()
    {
        Id = int.Parse(tmp[0]),
        Category = tmp[1],
        Manufacturer = tmp[2],
        Model = tmp[3],
        Price = int.Parse(tmp[4]),
        Stock = int.Parse(tmp[5]),
        Rating = float.Parse(tmp[6].Replace('.', ','))
    });
}
